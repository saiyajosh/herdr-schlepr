{
  "name": "herdr-schlepr",
  "version": "0.1.0",
  "description": "A polished Herdr popup for moving live panes and tabs across workspaces",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/launcher.ts src/popup/app.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist",
    "lint": "NODE_OPTIONS=--import=tsx oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "NODE_OPTIONS=--import=tsx oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test test/*.test.ts",
    "test:integration": "./scripts/integration-herdr.sh",
    "check": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "herdr",
    "herdr-plugin",
    "terminal",
    "tui"
  ],
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
